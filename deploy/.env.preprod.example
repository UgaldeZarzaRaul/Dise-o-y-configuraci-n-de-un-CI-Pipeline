# -----------------------------------------------------------------------------
# Plantilla de variables de entorno para PREPRODUCCIÓN.
# En el servidor se copia a $APP_DIR/shared/.env y se completan los valores.
# NUNCA se versiona el .env real ni se incluye en el artefacto.
# -----------------------------------------------------------------------------
APP_NAME="Laravel (Preproducción)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://preprod.example.local
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_preprod
DB_USERNAME=laravel_preprod
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# El correo en preproducción NO debe llegar a usuarios reales
MAIL_MAILER=log
MAIL_FROM_ADDRESS="preprod@example.local"
MAIL_FROM_NAME="${APP_NAME}"
